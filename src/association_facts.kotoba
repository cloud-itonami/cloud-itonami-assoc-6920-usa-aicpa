          (string=? f "url") (option-some-of [:option :string] "https://www.aicpa-cima.com/resources/download/aicpa-bylaws-and-implementing-resolutions-of-council")
          (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
          (string=? f "retrieved-at") (option-some-of [:option :string] "2026-07-15")
          :else (option-none-of [:option :string]))
      (= i 2) (cond
          (string=? f "id") (option-some-of [:option :string] "aicpa.sas-au-c-currently-effective")
          (string=? f "title") (option-some-of [:option :string] "AICPA SASs – currently effective")
          (string=? f "association") (option-some-of [:option :string] "aicpa")
          (string=? f "isic") (option-some-of [:option :string] "6920")
          (string=? f "country") (option-some-of [:option :string] "USA")
          (string=? f "kind") (option-some-of [:option :string] "professional-standard")
          (string=? f "url") (option-some-of [:option :string] "https://www.aicpa-cima.com/resources/download/aicpa-statements-on-auditing-standards-currently-effective")
          (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
          (string=? f "last-revised-date") (option-some-of [:option :string] "2026-08")
          (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-06")
          :else (option-none-of [:option :string]))
      (= i 3) (cond
          (string=? f "id") (option-some-of [:option :string] "aicpa.ssars-ar-c-currently-effective")
          (string=? f "title") (option-some-of [:option :string] "AICPA SSARSs – currently effective")
          (string=? f "association") (option-some-of [:option :string] "aicpa")
          (string=? f "isic") (option-some-of [:option :string] "6920")
          (string=? f "country") (option-some-of [:option :string] "USA")
          (string=? f "kind") (option-some-of [:option :string] "professional-standard")
          (string=? f "url") (option-some-of [:option :string] "https://www.aicpa-cima.com/resources/download/aicpa-ssarss-currently-effective")
          (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
          (string=? f "last-revised-date") (option-some-of [:option :string] "2026-08")
          (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-06")
          :else (option-none-of [:option :string]))
      (= i 4) (cond
          (string=? f "id") (option-some-of [:option :string] "aicpa.ssae-at-c-currently-effective")
          (string=? f "title") (option-some-of [:option :string] "AICPA SSAEs – currently effective")
          (string=? f "association") (option-some-of [:option :string] "aicpa")
          (string=? f "isic") (option-some-of [:option :string] "6920")
          (string=? f "country") (option-some-of [:option :string] "USA")
          (string=? f "kind") (option-some-of [:option :string] "professional-standard")
          (string=? f "url") (option-some-of [:option :string] "https://www.aicpa-cima.com/resources/download/aicpa-ssaes-currently-effective")
          (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
          (string=? f "last-revised-date") (option-some-of [:option :string] "2026-08")
          (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-06")
          :else (option-none-of [:option :string]))
      (= i 5) (cond
          (string=? f "id") (option-some-of [:option :string] "aicpa.statements-on-standards-for-tax-services")
          (string=? f "title") (option-some-of [:option :string] "Statements on Standards for Tax Services No. 1–4 (1/1/2024)")
          (string=? f "association") (option-some-of [:option :string] "aicpa")
          (string=? f "isic") (option-some-of [:option :string] "6920")
          (string=? f "country") (option-some-of [:option :string] "USA")
          (string=? f "kind") (option-some-of [:option :string] "professional-standard")
          (string=? f "url") (option-some-of [:option :string] "https://www.aicpa-cima.com/resources/download/revised-statements-on-standards-for-tax-services-no-1-4-1-1-2024")
          (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
          (string=? f "established-date") (option-some-of [:option :string] "2024-01-01")
          (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-06")
          :else (option-none-of [:option :string]))
      (= i 6) (cond
          (string=? f "id") (option-some-of [:option :string] "aicpa.quality-management-standards-no-1")
          (string=? f "title") (option-some-of [:option :string] "AICPA Statement on Quality Management Standards No. 1")
          (string=? f "association") (option-some-of [:option :string] "aicpa")
          (string=? f "isic") (option-some-of [:option :string] "6920")
          (string=? f "country") (option-some-of [:option :string] "USA")
          (string=? f "kind") (option-some-of [:option :string] "professional-standard")
          (string=? f "url") (option-some-of [:option :string] "https://www.aicpa-cima.com/resources/download/aicpa-statement-on-quality-management-standards-no-1")
          (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
          (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-06")
          :else (option-none-of [:option :string]))
      (= i 7) (cond
          (string=? f "id") (option-some-of [:option :string] "aicpa.peer-review-standards")
          (string=? f "title") (option-some-of [:option :string] "Clarified AICPA Standards For Performing and Reporting On Peer Reviews")
          (string=? f "association") (option-some-of [:option :string] "aicpa")
          (string=? f "isic") (option-some-of [:option :string] "6920")
          (string=? f "country") (option-some-of [:option :string] "USA")
          (string=? f "kind") (option-some-of [:option :string] "professional-standard")
          (string=? f "url") (option-some-of [:option :string] "https://www.aicpa-cima.com/resources/download/clarified-aicpa-standards-for-performing-and-reporting-on-peer-reviews")
          (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
          (string=? f "last-revised-date") (option-some-of [:option :string] "2026-02-28")
          (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-06")
          :else (option-none-of [:option :string]))
      (= i 8) (cond
          (string=? f "id") (option-some-of [:option :string] "aicpa.trust-services-criteria")
          (string=? f "title") (option-some-of [:option :string] "2017 Trust Services Criteria (With Revised Points of Focus — 2022)")
          (string=? f "association") (option-some-of [:option :string] "aicpa")
          (string=? f "isic") (option-some-of [:option :string] "6920")
          (string=? f "country") (option-some-of [:option :string] "USA")
          (string=? f "kind") (option-some-of [:option :string] "professional-standard")
          (string=? f "url") (option-some-of [:option :string] "https://www.aicpa-cima.com/resources/download/2017-trust-services-criteria-with-revised-points-of-focus-2022")
          (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
          (string=? f "established-date") (option-some-of [:option :string] "2017")
          (string=? f "last-revised-date") (option-some-of [:option :string] "2022")
          (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-06")
