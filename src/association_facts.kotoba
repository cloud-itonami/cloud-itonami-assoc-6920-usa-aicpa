          (string=? f "title") (option-some-of [:option :string] "2018 SOC 2® Description Criteria (With Revised Implementation Guidance – 2022)")
          (string=? f "association") (option-some-of [:option :string] "aicpa")
          (string=? f "isic") (option-some-of [:option :string] "6920")
          (string=? f "country") (option-some-of [:option :string] "USA")
          (string=? f "kind") (option-some-of [:option :string] "professional-standard")
