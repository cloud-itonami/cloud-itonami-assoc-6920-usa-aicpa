    (option-none-of [:option :string])))

(defn topic-count [a :string i :i64] :i64
  (if (valid-entry? a i)
    (cond
    (= i 0) 2
    (= i 1) 1
    (= i 2) 2
    (= i 3) 2
    (= i 4) 2
    (= i 5) 2
    (= i 6) 1
    (= i 7) 2
    (= i 8) 2
    (= i 9) 2
    :else 0)
    0))

(defn topic [a :string i :i64 t :i64] [:option :string]
  (if (valid-entry? a i)
    (cond
      (= i 0) (cond
          (= t 0) (option-some-of [:option :string] "ethics")
          (= t 1) (option-some-of [:option :string] "member-conduct")
          :else (option-none-of [:option :string]))
      (= i 1) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          :else (option-none-of [:option :string]))
      (= i 2) (cond
          (= t 0) (option-some-of [:option :string] "auditing")
          (= t 1) (option-some-of [:option :string] "assurance")
          :else (option-none-of [:option :string]))
      (= i 3) (cond
          (= t 0) (option-some-of [:option :string] "compilation-review")
          (= t 1) (option-some-of [:option :string] "assurance")
          :else (option-none-of [:option :string]))
      (= i 4) (cond
          (= t 0) (option-some-of [:option :string] "attestation")
          (= t 1) (option-some-of [:option :string] "assurance")
          :else (option-none-of [:option :string]))
      (= i 5) (cond
          (= t 0) (option-some-of [:option :string] "tax")
          (= t 1) (option-some-of [:option :string] "member-conduct")
          :else (option-none-of [:option :string]))
      (= i 6) (cond
          (= t 0) (option-some-of [:option :string] "quality-management")
          :else (option-none-of [:option :string]))
      (= i 7) (cond
          (= t 0) (option-some-of [:option :string] "peer-review")
          (= t 1) (option-some-of [:option :string] "quality-management")
          :else (option-none-of [:option :string]))
      (= i 8) (cond
          (= t 0) (option-some-of [:option :string] "soc")
          (= t 1) (option-some-of [:option :string] "information-security")
          :else (option-none-of [:option :string]))
      (= i 9) (cond
          (= t 0) (option-some-of [:option :string] "soc")
          (= t 1) (option-some-of [:option :string] "information-security")
          :else (option-none-of [:option :string]))
      :else (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn by-topic-count [a :string candidate :string] :i64
  (if (association-covered? a)
    (cond
    (string=? candidate "ethics") 1
    (string=? candidate "member-conduct") 2
    (string=? candidate "governance") 1
    (string=? candidate "auditing") 1
    (string=? candidate "assurance") 3
    (string=? candidate "compilation-review") 1
    (string=? candidate "attestation") 1
    (string=? candidate "tax") 1
    (string=? candidate "quality-management") 2
    (string=? candidate "peer-review") 1
    (string=? candidate "soc") 2
    (string=? candidate "information-security") 2
    :else 0)
    0))

(defn by-topic-id [a :string candidate :string i :i64] [:option :string]
  (if (association-covered? a)
    (cond
    (string=? candidate "ethics") (cond
        (= i 0) (entry-field a 0 "id")
        :else (option-none-of [:option :string]))
    (string=? candidate "member-conduct") (cond
        (= i 0) (entry-field a 0 "id")
        (= i 1) (entry-field a 5 "id")
        :else (option-none-of [:option :string]))
    (string=? candidate "governance") (cond
        (= i 0) (entry-field a 1 "id")
        :else (option-none-of [:option :string]))
    (string=? candidate "auditing") (cond
        (= i 0) (entry-field a 2 "id")
        :else (option-none-of [:option :string]))
    (string=? candidate "assurance") (cond
        (= i 0) (entry-field a 2 "id")
        (= i 1) (entry-field a 3 "id")
        (= i 2) (entry-field a 4 "id")
        :else (option-none-of [:option :string]))
    (string=? candidate "compilation-review") (cond
        (= i 0) (entry-field a 3 "id")
        :else (option-none-of [:option :string]))
    (string=? candidate "attestation") (cond
        (= i 0) (entry-field a 4 "id")
        :else (option-none-of [:option :string]))
    (string=? candidate "tax") (cond
        (= i 0) (entry-field a 5 "id")
        :else (option-none-of [:option :string]))
    (string=? candidate "quality-management") (cond
        (= i 0) (entry-field a 6 "id")
        (= i 1) (entry-field a 7 "id")
        :else (option-none-of [:option :string]))
    (string=? candidate "peer-review") (cond
        (= i 0) (entry-field a 7 "id")
        :else (option-none-of [:option :string]))
    (string=? candidate "soc") (cond
        (= i 0) (entry-field a 8 "id")
        (= i 1) (entry-field a 9 "id")
        :else (option-none-of [:option :string]))
    (string=? candidate "information-security") (cond
        (= i 0) (entry-field a 8 "id")
        (= i 1) (entry-field a 9 "id")
        :else (option-none-of [:option :string]))
    :else (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn coverage-note [a :string] [:option :string]
  (if (association-covered? a)
    (option-some-of [:option :string] "cloud-itonami-assoc-6920-usa-aicpa (ADR-2607141700): 10 aicpa rules, each citing an official AICPA URL confirmed to resolve to the named document. Extend `association.facts/catalog`, never fabricate a rule id/url.")
    (option-none-of [:option :string])))

(defn main [] :i64 0)
