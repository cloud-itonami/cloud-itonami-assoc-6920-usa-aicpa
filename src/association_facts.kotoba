;; The AICPA source catalog, as Kotoba.
;;
;; GENERATED by tools/gen_kotoba.cljs from data/datascript-tx.edn, which
;; src/association/facts.cljc holds as a hand-authored literal. Both are the same
;; catalog; this one reaches the Kotoba oracle, wasm and both native ISAs, which
;; the .cljc cannot. Do not edit by hand -- regenerate.
;;
;; `:topic` is a SET in the .cljc. A set has no order and `topic` is indexed by
;; position, so this file uses the order the data file writes. `by-topic-id`
;; answers by name and is unaffected.
;;
;; Parity: test/association_facts_kotoba_parity_test.clj compares every field of
;; every entry against the .cljc, so this file cannot drift from the data without
;; the suite saying so.

(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count
            topic by-topic-count by-topic-id coverage-note]))

(defn association-covered? [a :string] :bool (string=? a "aicpa"))

(defn entry-count [a :string] :i64 (if (association-covered? a) 10 0))

(defn valid-entry? [a :string i :i64] :bool
  (if (association-covered? a) (if (< i 0) false (< i 10)) false))

(defn entry-field [a :string i :i64 f :string] [:option :string]
  (if (valid-entry? a i)
    (cond
      (= i 0) (cond
          (string=? f "id") (option-some-of [:option :string] "aicpa.code-of-professional-conduct")
          (string=? f "title") (option-some-of [:option :string] "Code of Professional Conduct")
          (string=? f "association") (option-some-of [:option :string] "aicpa")
          (string=? f "isic") (option-some-of [:option :string] "6920")
          (string=? f "country") (option-some-of [:option :string] "USA")
          (string=? f "kind") (option-some-of [:option :string] "self-regulatory-code")
          (string=? f "url") (option-some-of [:option :string] "https://pub.aicpa.org/codeofconduct/ethicsresources/et-cod.pdf")
          (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
          (string=? f "established-date") (option-some-of [:option :string] "2014-12-15")
          (string=? f "last-revised-date") (option-some-of [:option :string] "2025-12")
          (string=? f "retrieved-at") (option-some-of [:option :string] "2026-07-15")
          :else (option-none-of [:option :string]))
      (= i 1) (cond
          (string=? f "id") (option-some-of [:option :string] "aicpa.bylaws-and-council-resolutions")
          (string=? f "title") (option-some-of [:option :string] "AICPA Bylaws and Implementing Resolutions of Council")
